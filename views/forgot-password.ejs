<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main>
    <div class="auth-page">
        <div class="auth-card">
            <% if (!submitted) { %>
                <h1>Reset your password</h1>
                <p class="subtitle">Enter your email and we'll send you a reset link.</p>
                <form method="POST" action="/forgot-password" novalidate>
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="form-group">
                        <label class="form-label" for="email">Email</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="you@university.edu" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg">Send Reset Link</button>
                </form>
            <% } else { %>
                <div class="modal-icon" style="background: var(--color-accent-light); color: var(--color-accent);">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.6"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6"/></svg>
                </div>
                <h1>Check your inbox</h1>
                <p class="subtitle">If an account exists with that email, a reset link is on its way.</p>
            <% } %>
            <div class="auth-switch">Remembered it? <a href="/login">Back to log in</a></div>
        </div>
    </div>
</main>
<%- include('partials/footer') %>
