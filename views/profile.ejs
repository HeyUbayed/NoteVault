<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="container profile-container">
  <div class="profile-header">
    <h2><%= user.name %></h2>
    <p><%= user.email %></p>
  </div>

  <!-- Profile Navigation Tabs -->
  <div class="profile-tabs">
    <button class="profile-tab-btn active" data-tab="tab-notes">
      My Notes (<%= notes ? notes.length : 0 %>)
    </button>
    <button class="profile-tab-btn" data-tab="tab-bookmarks">
      Bookmarks (<%= bookmarks ? bookmarks.length : 0 %>)
    </button>
    <button class="profile-tab-btn" data-tab="tab-settings">
      Settings
    </button>
  </div>

  <!-- Profile Content Sections -->
  <div class="profile-content">
    <!-- My Notes Tab -->
    <section id="tab-notes" class="profile-tab-content">
      <h3>Uploaded Notes</h3>
      <% if (notes && notes.length > 0) { %>
        <div class="notes-grid">
          <% notes.forEach(note => { %>
            <%- include('partials/note-card', { note: note }) %>
          <% }) %>
        </div>
      <% } else { %>
        <p>No notes uploaded yet.</p>
      <% } %>
    </section>

    <!-- Bookmarks Tab -->
    <section id="tab-bookmarks" class="profile-tab-content hidden">
      <h3>Bookmarked Notes</h3>
      <% if (bookmarks && bookmarks.length > 0) { %>
        <div class="notes-grid">
          <% bookmarks.forEach(bookmark => { %>
            <%- include('partials/note-card', { note: bookmark.Note || bookmark }) %>
          <% }) %>
        </div>
      <% } else { %>
        <p>No bookmarked notes found.</p>
      <% } %>
    </section>

    <!-- Settings Tab -->
    <section id="tab-settings" class="profile-tab-content hidden">
      <h3>Account Settings</h3>
      <form action="/profile/settings" method="POST">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" value="<%= user.name %>" required />
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= user.email %>" disabled />
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </form>
    </section>
  </div>
</main>

<script src="/js/profile.js"></script>
<%- include('partials/footer') %>
