<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main>
    <div class="container">
<%- include('partials/breadcrumb', { crumbs: [{ label: 'Home', url: '/' }, { label: 'Dashboard', url: '/dashboard' }, { label: 'Profile' }] }) %>
        <div class="page-header">
            <h1>Your Profile</h1>
            <p>Manage your account, notes, and bookmarks.</p>
        </div>

        <% if (success) { %><div class="form-success-box mt-3">Profile updated successfully.</div><% } %>
        <% if (errors && errors.length > 0) { %>
            <div class="form-error-box mt-3"><ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }) %></ul></div>
        <% } %>

        <div class="dash-layout mt-3">
            <%- include('partials/dash-sidebar', { activePage: 'profile' }) %>

            <div>
                <div class="tabs">
                    <button class="tab-btn active" data-tab="tabOverview">Overview</button>
                    <button class="tab-btn" data-tab="tabNotes">My Notes (<%= myNotes.length %>)</button>
                    <button class="tab-btn" data-tab="tabBookmarks">Bookmarks (<%= bookmarks.length %>)</button>
                    <button class="tab-btn" data-tab="tabSettings">Settings</button>
                </div>

                <div class="tab-panel active" id="tabOverview">
                    <div class="stat-grid">
                        <div class="stat-card">
                            <strong><%= myNotes.length %></strong>
                            <span>Notes Uploaded</span>
                        </div>
                        <div class="stat-card">
                            <strong><%= user.credit %></strong>
                            <span>Credit Balance</span>
                        </div>
                        <div class="stat-card">
                            <strong>★ <%= Number(user.average_rating).toFixed(1) %></strong>
                            <span>Average Rating</span>
                        </div>
                        <div class="stat-card">
                            <strong><%= stats.total_downloads_received || 0 %></strong>
                            <span>Downloads Received</span>
                        </div>
                    </div>
                    <div class="data-table-wrap mb-3" style="padding: 24px;">
                        <h3 style="font-size: 1rem; margin-bottom: 14px;">Achievements</h3>
                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            <% if (myNotes.length >= 1) { %>
                                <span class="badge badge-primary">🌱 First Upload</span>
                            <% } %>
                            <% if (myNotes.length >= 5) { %>
                                <span class="badge badge-secondary">📚 Prolific Uploader</span>
                            <% } %>
                            <% if (myNotes.length >= 15) { %>
                                <span class="badge badge-secondary">🏆 Power Contributor</span>
                            <% } %>
                            <% if (Number(user.average_rating) >= 4.5 && myNotes.length > 0) { %>
                                <span class="badge badge-accent">⭐ Top Rated</span>
                            <% } %>
                            <% if ((stats.total_downloads_received || 0) >= 50) { %>
                                <span class="badge badge-warning">🔥 Popular Uploader</span>
                            <% } %>
                            <% if (bookmarks.length >= 5) { %>
                                <span class="badge badge-neutral">🔖 Avid Reader</span>
                            <% } %>
                            <% if (myNotes.length === 0) { %>
                                <span class="text-muted" style="font-size:0.85rem;">Upload your first note to start earning achievements!</span>
                            <% } %>
                        </div>
                    </div>

                    <div class="data-table-wrap" style="padding: 24px;">
                        <h3 style="font-size: 1rem; margin-bottom: 14px;">About</h3>
                        <p class="text-muted"><%= user.bio || 'No bio added yet. Tell others about yourself in Settings.' %></p>
                        <div class="mt-3" style="display:flex; gap: 24px; flex-wrap: wrap; font-size: 0.85rem;">
                            <span class="text-muted">Department: <strong style="color: var(--color-text);"><%= user.department || 'Not set' %></strong></span>
                            <span class="text-muted">Joined: <strong style="color: var(--color-text);"><%= new Date(user.joined_date).toLocaleDateString() %></strong></span>
                        </div>
                    </div>
                </div>

                <div class="tab-panel" id="tabNotes">
                    <% if (myNotes.length === 0) { %>
                        <div class="empty-state"><h3>No notes yet</h3><p>Upload your first note to see it here.</p><a href="/upload" class="btn btn-primary mt-2">Upload a Note</a></div>
                    <% } else { %>
                        <div class="grid-cards">
                            <% myNotes.forEach(function(n) { %>
                                <%- include('partials/note-card', { note: Object.assign({}, n, { uploader_name: user.name, uploader_image: user.profile_image }) }) %>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="tab-panel" id="tabBookmarks">
                    <% if (bookmarks.length === 0) { %>
                        <div class="empty-state"><h3>No bookmarks yet</h3><p>Bookmark notes you want to revisit later.</p><a href="/browse" class="btn btn-primary mt-2">Browse Notes</a></div>
                    <% } else { %>
                        <div class="grid-cards">
                            <% bookmarks.forEach(function(n) { %>
                                <%- include('partials/note-card', { note: n }) %>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="tab-panel" id="tabSettings">
                    <div class="data-table-wrap mb-3" style="padding: 24px;">
                        <h3 style="font-size: 1rem; margin-bottom: 18px;">Profile Photo</h3>
                        <div style="display:flex; align-items:center; gap: 18px;">
                            <img src="<%= user.profile_image %>" alt="" style="width:70px;height:70px;border-radius:50%;object-fit:cover;border:3px solid var(--color-primary-light);">
                            <form id="avatarForm" method="POST" action="/profile/image" enctype="multipart/form-data">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <label class="btn btn-outline btn-sm" style="cursor:pointer;">
                                    Change Photo
                                    <input type="file" id="avatarInput" name="profile_image" accept="image/*" style="display:none;">
                                </label>
                            </form>
                        </div>
                    </div>

                    <div class="data-table-wrap mb-3" style="padding: 24px;">
                        <h3 style="font-size: 1rem; margin-bottom: 18px;">Basic Information</h3>
                        <form method="POST" action="/profile">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <div class="form-group">
                                <label class="form-label">Full Name</label>
                                <input type="text" name="name" class="form-control" value="<%= user.name %>" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Department</label>
                                <select name="department" class="form-control">
                                    <option value="">Select department</option>
                                    <% ['CSE','EEE','BBA','English','Civil Engineering','Pharmacy','Economics','Other'].forEach(function(d) { %>
                                        <option <%= user.department === d ? 'selected' : '' %>><%= d %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Bio</label>
                                <textarea name="bio" class="form-control" placeholder="Tell others about yourself..."><%= user.bio %></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </form>
                    </div>

                    <div class="data-table-wrap" style="padding: 24px;">
                        <h3 style="font-size: 1rem; margin-bottom: 18px;">Change Password</h3>
                        <form id="passwordChangeForm" data-no-loading-bar="true">
                            <div class="form-group">
                                <label class="form-label">Current Password</label>
                                <input type="password" name="currentPassword" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">New Password</label>
                                <input type="password" name="newPassword" class="form-control" required minlength="8">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Confirm New Password</label>
                                <input type="password" name="confirmPassword" class="form-control" required minlength="8">
                            </div>
                            <button type="submit" class="btn btn-primary">Update Password</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<%- include('partials/footer', { extraJs: ['/js/profile.js', '/js/browse.js'] }) %>
