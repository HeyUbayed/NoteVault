<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main>
    <div class="auth-page">
        <div class="auth-card">
            <h1>Welcome back</h1>
            <p class="subtitle">Log in to keep sharing and downloading notes.</p>

            <% if (errors && errors.length > 0) { %>
                <div class="form-error-box">
                    <ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }) %></ul>
                </div>
            <% } %>

            <form method="POST" action="/login" novalidate>
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="you@university.edu" value="<%= old.email || '' %>" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <div class="password-toggle-wrap">
                        <input type="password" id="password" name="password" class="form-control" placeholder="Your password" required>
                        <button type="button" class="password-toggle" data-target="password">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
                        </button>
                    </div>
                </div>
                <div style="text-align:right; margin-bottom: 20px;">
                    <a href="/forgot-password" style="font-size:0.83rem; color:var(--color-primary); font-weight:600;">Forgot password?</a>
                </div>
                <button type="submit" class="btn btn-primary btn-block btn-lg">Log In</button>
            </form>

            <div class="auth-switch">New to NoteVault? <a href="/register">Create an account</a></div>
        </div>
    </div>
</main>
<%- include('partials/footer', { extraJs: ['/js/auth.js'] }) %>
