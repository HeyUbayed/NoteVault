<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📚</text></svg>">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Manage Users · NoteVault Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/components.css">
</head>
<body>
<div class="toast-container" id="toastContainer"></div>
<%- include('_sidebar', { activeAdmin: 'users' }) %>
    <nav class="breadcrumb" style="margin-top:0; margin-bottom: 10px;"><a href="/admin">Admin</a><span class="breadcrumb-sep">/</span><span class="breadcrumb-current">Manage Users</span></nav>
    <div class="admin-topbar">
        <div><h1>Manage Users</h1><p class="text-muted">View, suspend, or remove student accounts.</p></div>
        <input type="text" id="userSearchInput" class="form-control" placeholder="Search by name or email..." value="<%= search %>" style="max-width: 280px;">
    </div>

    <div class="data-table-wrap">
        <table class="data-table">
            <thead><tr><th>User</th><th>Department</th><th>Credit</th><th>Rating</th><th>Joined</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr><td colspan="7" class="text-center text-muted" style="padding: 40px;">No users found.</td></tr>
                <% } %>
                <% users.forEach(function(u) { %>
                    <tr>
                        <td>
                            <div class="cell-user">
                                <div>
                                    <strong style="display:block;"><%= u.name %></strong>
                                    <span class="text-muted" style="font-size:0.78rem;"><%= u.email %></span>
                                </div>
                            </div>
                        </td>
                        <td><%= u.department || '—' %></td>
                        <td><%= u.credit %></td>
                        <td>★ <%= Number(u.average_rating).toFixed(1) %></td>
                        <td class="text-muted"><%= new Date(u.joined_date).toLocaleDateString() %></td>
                        <td><span class="badge <%= u.is_banned ? 'badge-danger' : 'badge-accent' %>"><%= u.is_banned ? 'Suspended' : 'Active' %></span></td>
                        <td>
                            <div class="row-actions">
                                <button class="btn btn-outline btn-sm js-ban-toggle" data-user-id="<%= u.id %>"><%= u.is_banned ? 'Reinstate' : 'Suspend' %></button>
                                <button class="btn btn-danger btn-sm js-delete-user" data-user-id="<%= u.id %>">Delete</button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/pagination', { currentPage, totalPages, baseUrl: '/admin/users', filters: {} }) %>
    </div>
</div>
<script src="/js/main.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
