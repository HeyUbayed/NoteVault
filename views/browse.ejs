<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main>
    <div class="container">
<%- include('partials/breadcrumb', { crumbs: [{ label: 'Home', url: '/' }, { label: 'Browse Notes' }] }) %>
        <div class="page-header">
            <h1>Browse Notes</h1>
            <p>All notes shared by the NoteVault community, newest first.</p>
        </div>

        <p class="text-muted mt-3"><%= totalCount %> notes found</p>

        <% if (notes.length === 0) { %>
            <div class="empty-state">
                <svg width="52" height="52" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                <h3>No notes uploaded yet</h3>
                <p>Be the first to share your notes with the community.</p>
            </div>
        <% } else { %>
            <div class="grid-cards">
                <% notes.forEach(function(n) { %>
                    <%- include('partials/note-card', { note: n }) %>
                <% }) %>
            </div>
            <%- include('partials/pagination', { currentPage, totalPages, baseUrl: '/browse' }) %>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>
